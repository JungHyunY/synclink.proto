{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yoonikon SyncLink",
  "version": "1.0.12",
  "identifier": "com.yoonikon.synclink",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Yoonikon SyncLink",
        "width": 1000,
        "height": 680,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1ODFBNjIwQTc5NkQzREQKUldUZDA1YW5JS2FCeGFRcFVDL1Ryejdlb3FYOEgwbHpDSnJaeWgyTnE4eTR1ZjlvRTZLMExwVlQK",
      "endpoints": [
        "https://github.com/JungHyunY/synclink.proto/releases/latest/download/latest.json"
      ]
    }
  }
}
